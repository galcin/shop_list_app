# Copy this file to tool/.env and fill in your real token.
# tool/.env is gitignored — it will never be committed.
#
# Option A — fal.ai (key format: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:hex"):
# Get a key at: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Option B — Replicate (key format: "r8_..."):
# Get a token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here
